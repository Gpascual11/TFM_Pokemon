\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Diferència conceptual entre un MDP, un POMDP i un POSG. En el POMDP l'agent rep una observació parcial de l'estat. Una batalla Pokémon afegeix un segon decisor i, per tant, s'aproxima millor amb un POSG.}}{6}{figure.caption.6}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Estructura d'una batalla individual: un Pokémon actiu per bàndol i un banc de fins a cinc substituts. Si el fitxer commemoratiu original és present al repositori, s'utilitza com a contextualització visual; si no, el esquema recull la mateixa informació estructural.}}{7}{figure.caption.9}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Valors finals de combat d'un Pikachu d'exemple. Si hi ha una captura al repositori, s'hi mostra la pantalla de resum; si no, les barres reprodueixen els totals de la Taula~\ref {tab:pikachu_stat_example}.}}{8}{figure.caption.10}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Construcció d'una estadística de combat. Si el calculador original és present, s'hi mostra com a captura; el diagrama recull els mateixos cinc components de les equacions~\eqref {eq:stat_formula}--\eqref {eq:hp_formula}.}}{9}{figure.caption.12}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Cicle clàssic de l'MCTS. La variant d'aquest treball omet l'expansió recursiva: les 100 visites es reparteixen entre les accions legals de l'arrel i cada simulació dura cinc torns.}}{13}{figure.caption.16}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Intuïció de l'objectiu retallat de PPO. Per a avantatges positius, una raó $r_t$ massa gran deixa de contribuir un cop supera $1+\epsilon $; simètricament, per a avantatges negatius es limita la caiguda per sota de $1-\epsilon $.}}{14}{figure.caption.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Disseny conceptual de l'estudi. La mateixa infraestructura avalua polítiques diferents i retorna dades tant del resultat com del comportament. El PPO comparteix simulador, però no entra a la matriu $28\times 28$.}}{17}{figure.caption.18}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Genealogia de disseny, no una ordenació de força. \texttt {v7} reescriu el nucli; minimax, MCTS i imitació parteixen de \texttt {v14} com a fulla, prior o executor. PPO clona \texttt {v8} i s'avalua contra \texttt {v12}.}}{17}{figure.caption.19}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Currículum PPO previst. Cada fletxa és una porta de validació independent de la corba d'entrenament. La fase 2 no supera el llindar; la fase 3 es fa igualment com a mesura contra \texttt {v12}.}}{19}{figure.caption.21}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Tauler Kanban utilitzat per organitzar el desenvolupament del TFM.}}{26}{figure.caption.29}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Mapa de mòduls. \texttt {p00} aïlla simulació i persistència; \texttt {p01}--\texttt {p05} només afegeixen la política. Minimax, MCTS i imitació reutilitzen coneixement de \texttt {p01}; PPO té entorn, checkpoints i avaluació propis.}}{29}{figure.caption.30}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Intercanvi simplificat entre un agent i una instància local de Showdown.}}{30}{figure.caption.31}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Flux d'adaptació entre el protocol de Showdown i una política Python.}}{31}{figure.caption.32}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Arquitectura de la matriu experimental, sense memòria compartida entre processos de treball.}}{31}{figure.caption.33}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Monitoratge durant una execució al prototip de 16~GB. La memòria creix mentre s'acumulen batalles i cau després de reiniciar processos; el patró va motivar els blocs curts, la recollida de memòria i els reinicis de Showdown. Si la captura original no és al directori d'imatges, el diagrama recull el mateix patró de dent de serra.}}{33}{figure.caption.34}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Validació exploratòria de les repeticions humanes: desequilibri entre atacar i canviar, evolució de la taxa de canvi amb el torn i espècies més representades. La figura descriu el conjunt de dades, no el rendiment final de l'agent.}}{37}{figure.caption.43}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Taxa de canvi humana per espècie activa en una selecció del conjunt d'experts. La variació justifica incloure identitat i context, però no implica causalitat: espècie, rol, rival i estat de la partida estan correlacionats.}}{37}{figure.caption.44}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Pas d'inferència de MaskablePPO. La màscara s'aplica abans de mostrejar; l'índex no s'envia mai directament al servidor, sinó com a ordre de Showdown.}}{40}{figure.caption.49}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Seqüència clonatge $\rightarrow $ reforç. El crític no s'entrena al clonatge; PPO n'aprèn el valor a partir de la recompensa modelada un cop l'actor ja imita el professor.}}{40}{figure.caption.50}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Corbes de les quatre etapes del currículum. Són taxes durant l'entrenament sobre una política canviant; les validacions independents són les de la Taula~\ref {tab:ppo_curriculum_impl}. El panell de fase 3 correspon a la passada secundària, no al model A publicat.}}{42}{figure.caption.56}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Nombre de partides completades a les 784 cel·les. El bloc fosc correspon a 10.000 partides; les files i columnes clares de \texttt {v18}--\texttt {v20}, a 1.000. La creu no és un buit de dades, sinó el pressupost reduït de l'MCTS.}}{46}{figure.caption.58}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Distribució de la taxa de victòries de les 784 cel·les dirigides. El centre prop del 50\% conté autojoc i enfrontaments equilibrats; les cues reflecteixen diferències grans, especialment davant de Random i MaxBasePower.}}{46}{figure.caption.59}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Distribució de la durada de les batalles analitzades. La mediana és de 17 torns i hi ha una cua dreta de partides excepcionalment llargues.}}{47}{figure.caption.60}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Taxa global de victòries de \texttt {v1}--\texttt {v14} (253.000 partides per fila; les tres cel·les contra MCTS tenen $n=1.000$). S'observen canvis destacats a \texttt {v7}, \texttt {v9} i \texttt {v12}, seguits d'una disminució a \texttt {v13} i \texttt {v14}.}}{48}{figure.caption.63}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces \texttt {v1}--\texttt {v14} contra els sis agents de referència ($n=10.000$ per cel·la). \texttt {v12} és el primer que deixa Abyssal i Simple Heuristic clarament per sota del 50\%. Contra \texttt {random}, totes les heurístiques arriben al 97--98\% i la columna deixa de ser discriminant.}}{49}{figure.caption.64}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Empremta tàctica de la seqüència heurística. \texttt {v12} utilitza la Teracristal·lització gairebé una vegada per partida; \texttt {v13}, 0,20 vegades. \texttt {ko\_checks} augmenta fins a aproximadament 15 a \texttt {v14}; la preparació i els perills d'entrada apareixen a partir de \texttt {v9}.}}{50}{figure.caption.65}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Enfrontaments directes, amb $n=10.000$ per orientació. \texttt {v12} i \texttt {v13} no presenten una separació concloent; \texttt {v14} obté 44,74\% contra \texttt {v12} i 41,60\% contra \texttt {v13}.}}{51}{figure.caption.67}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Enfrontaments de referència de \texttt {v12}, \texttt {v13} i \texttt {v14}. Les files representen l'agent avaluat. Les cel·les MCTS tenen $n=1.000$ i la resta, $n=10.000$. \texttt {v12} domina els agents de referència; \texttt {v13} és més fort contra cerca i \texttt {v21}.}}{52}{figure.caption.68}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Taxa de victòries de la inversió, agregada per paradigma d'oponent. \texttt {v12} és millor contra agents de referència i altres heurístiques; \texttt {v13}, contra minimax, MCTS i imitació híbrida.}}{52}{figure.caption.69}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Relació entre volum de canvis i taxa de victòries. La freqüència de canvi, per si sola, no mesura la qualitat de la política; cal distingir-ne el motiu.}}{53}{figure.caption.70}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Durada i membres de l'equip disponibles al final. \texttt {v13} juga partides més llargues i conserva més Pokémon, mentre que \texttt {v12} obté una taxa de victòries superior.}}{53}{figure.caption.71}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Taxa de discrepància respecte de \texttt {v14} en els torns en què s'executa el maximin. \texttt {v15}/\texttt {v16} discrepen aproximadament en el 67\% dels casos; \texttt {v17}, amb prior $+0{,}15$, en el 37\%. Les derrotes presenten una discrepància mitjana superior, una associació que no implica causalitat.}}{54}{figure.caption.73}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Indicadors d'efectes diferits: preparació, perills d'entrada i Teracristal·lització. \texttt {v16} manté la preparació al voltant de 0,21 usos per partida, un nivell semblant al de \texttt {v14} i molt inferior al de \texttt {v12}.}}{55}{figure.caption.74}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Distribució de la durada i dels Pokémon restants a minimax. Les tres variants duren aproximadament 19 torns, però \texttt {v17} conserva 1,39 membres de mitjana, davant d'1,28--1,29.}}{56}{figure.caption.75}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Distribució dels canvis voluntaris, dels canvis decidits pel maximin i de la fracció de decisions de cerca que són canvis. \texttt {v17} presenta una mediana superior de canvis tot i discrepar menys de \texttt {v14}.}}{56}{figure.caption.76}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Empremta \texttt {v15}--\texttt {v17}: KO checks $\sim $14, cerca $\sim $16--18\% dels torns, Tera $\sim $0,39 (nivell \texttt {v14}, no \texttt {v12}).}}{57}{figure.caption.77}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Enfrontaments de referència del minimax d'un torn. Les cel·les contra MCTS tenen $n=1.000$. \texttt {v17} millora respecte de les altres variants, però no supera el 50\% contra \texttt {v14}.}}{57}{figure.caption.78}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Taxa de victòries agrupada. \texttt {v15} i \texttt {v16} se superposen; \texttt {v17} queda per sobre, encara per sota de \texttt {v9}/\texttt {v11}.}}{57}{figure.caption.79}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Taxa de victòries del minimax per família d'oponent. El prior de \texttt {v17} s'associa amb les millores principals contra heurístiques i MCTS.}}{58}{figure.caption.80}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Taxa de discrepància respecte de \texttt {v14} entre les decisions de cerca. UCB1 (\texttt {v18}/\texttt {v19}) discrepa aproximadament en el 71\% dels casos i PUCT (\texttt {v20}), en el 19\%. Les derrotes mostren més discrepància mitjana, una associació que no estableix causalitat.}}{59}{figure.caption.82}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Indicadors d'efectes diferits a les simulacions de cinc torns. La preparació i els perills d'entrada es mantenen a nivells semblants als de \texttt {v14}.}}{60}{figure.caption.83}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Durada i Pokémon restants a MCTS. \texttt {v20} acaba lleugerament abans (18,33 torns) i conserva 1,40 membres de mitjana, davant d'1,21--1,22 a UCB1.}}{61}{figure.caption.84}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Distribució dels canvis a MCTS. PUCT augmenta la fracció de decisions de cerca que acaben en canvi i amplia la distribució de canvis voluntaris.}}{61}{figure.caption.85}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Empremta MCTS. Cerca 16--18\% dels torns; KO $\sim $14/partida. \texttt {v20} busca menys i acaba amb més HP. $n=1.000$ per oponent.}}{62}{figure.caption.86}%
\contentsline {figure}{\numberline {6.25}{\ignorespaces Enfrontaments discriminants d'MCTS. Les files representen l'agent avaluat i totes les cel·les tenen $n=1.000$. \texttt {v20} s'acosta a Abyssal (49\%) i no supera \texttt {v12} (42,7\%).}}{62}{figure.caption.87}%
\contentsline {figure}{\numberline {6.26}{\ignorespaces Taxa de victòries agrupada d'MCTS. \texttt {v18} i \texttt {v19} se superposen; \texttt {v20} queda per sobre. Aquesta mitjana de 28.000 partides no té la mateixa ponderació que les files de 253.000.}}{62}{figure.caption.88}%
\contentsline {figure}{\numberline {6.27}{\ignorespaces Taxa de victòries d'MCTS per paradigma d'oponent ($n=1.000$ a cada cel·la). PUCT millora principalment contra heurístiques i minimax.}}{63}{figure.caption.89}%
\contentsline {figure}{\numberline {6.28}{\ignorespaces Empremta dels agents d'imitació. \texttt {v21} registra aproximadament 14 proteccions de debilitament per partida i consulta XGBoost en el 15\% dels torns. \texttt {v22} no té aquestes proteccions, consulta XGBoost en el 80\% dels torns i activa la protecció de bucle en el 97\% de les partides.}}{64}{figure.caption.91}%
\contentsline {figure}{\numberline {6.29}{\ignorespaces Freqüència d'ús de la política apresa. XGBoost intervé en el 15\% dels torns de \texttt {v21} i en el 80\% dels de \texttt {v22}.}}{65}{figure.caption.92}%
\contentsline {figure}{\numberline {6.30}{\ignorespaces Durada i Pokémon restants dels agents d'imitació. \texttt {v22} juga partides més llargues (20,07 torns) però acaba amb només 0,70 membres, davant d'1,33 a \texttt {v21}.}}{66}{figure.caption.93}%
\contentsline {figure}{\numberline {6.31}{\ignorespaces Distribució dels canvis a imitació. \texttt {v22} fa aproximadament el doble de canvis voluntaris i rep moltes més ordres de canvi del classificador.}}{66}{figure.caption.94}%
\contentsline {figure}{\numberline {6.32}{\ignorespaces Indicadors tàctics. \texttt {v22} i \texttt {v12} utilitzen la Teracristal·lització amb freqüències similars, però obtenen resultats molt diferents; la freqüència no mesura la qualitat de la decisió.}}{67}{figure.caption.95}%
\contentsline {figure}{\numberline {6.33}{\ignorespaces Taxa de victòries agrupada de les dues arquitectures d'imitació. \texttt {v21} se situa prop de \texttt {v9}; \texttt {v22}, per sota de \texttt {v1}.}}{67}{figure.caption.96}%
\contentsline {figure}{\numberline {6.34}{\ignorespaces Taxa de victòries dels agents d'imitació per família d'oponent. \texttt {v21} supera \texttt {v22} en els sis blocs, amb diferències d'aproximadament 20--26~pp.}}{67}{figure.caption.97}%
\contentsline {figure}{\numberline {6.35}{\ignorespaces Taxa de victòries de \texttt {v21} i \texttt {v22} per oponent. Tots els punts queden sobre la diagonal: \texttt {v21} obté el valor superior en 28 de 28 enfrontaments. La diferència màxima és de 32,6~pp contra \texttt {safe\_one\_step}.}}{68}{figure.caption.98}%
\contentsline {figure}{\numberline {6.36}{\ignorespaces Mapa de calor de la taxa de victòries a \texttt {gen9randombattle}. La fila és l'agent analitzat i la columna, l'oponent. Prefixos: (H) heurística, (MM) minimax, (MCT) MCTS, (IL) imitació i (B) agent de referència. Les cel·les amb MCTS tenen $n=1.000$; la resta, $n=10.000$.}}{70}{figure.caption.102}%
\contentsline {figure}{\numberline {6.37}{\ignorespaces Escala Bradley--Terry ancorada a \texttt {random}${}=1000$, amb les dues orientacions. \texttt {v12} i \texttt {v13} obtenen les puntuacions més altes. \texttt {v14}, Abyssal i Simple Heuristic comparteixen el mateix valor arrodonit. Les files MCTS aporten menys partides al model.}}{71}{figure.caption.104}%
\contentsline {figure}{\numberline {6.38}{\ignorespaces Taxa de victòries i Elo de \texttt {v14} a la classificació pública: 431 partides entre el 9 i el 10 de juny de 2026, 39,44\% $\pm 4,6$~pp i Elo de 1085 a 1038 (màxim 1263).}}{72}{figure.caption.106}%
\contentsline {figure}{\numberline {6.39}{\ignorespaces Evolució de l'Elo al llarg de les 431 partides. Una mostra prefixa de 98 partides, presa prop del màxim, no representa el resultat final.}}{72}{figure.caption.107}%
\contentsline {figure}{\numberline {6.40}{\ignorespaces Victòries i derrotes segons la durada. El subconjunt de partides amb almenys 10 torns és descriptiu; la taxa principal utilitza les 431 partides sense filtrar.}}{73}{figure.caption.108}%
\addvspace {10\p@ }
